{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a2a-compliance:wire:stage-receipt",
  "title": "StageReceipt",
  "description": "Mirrors a2a_compliance.lifecycle.StageReceipt exactly: role, capability, status, action_digest, input_digest, output_digest, reason. The __post_init__ invariants of that dataclass (NOT_APPLICABLE needs a reason; SATISFIED needs an output_digest) are re-expressed here as schema conditionals so a wire-level tamper cannot bypass them.",
  "allOf": [
    { "$ref": "urn:a2a-compliance:wire:envelope-base" },
    {
      "if": { "properties": { "status": { "const": "NOT_APPLICABLE" } }, "required": ["status"] },
      "then": { "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "SATISFIED" } }, "required": ["status"] },
      "then": { "required": ["output_digest"] }
    }
  ],
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["role", "capability", "status", "action_digest", "input_digest"],
  "properties": {
    "type": { "const": "StageReceipt" },
    "role": { "type": "string", "minLength": 1, "description": "must match lifecycle.TOOL_OWNERS[capability] when capability is a tool: capability" },
    "capability": { "type": "string", "minLength": 1 },
    "status": { "enum": ["SATISFIED", "NOT_APPLICABLE", "NOT_SATISFIED", "OPEN", "ERROR"] },
    "action_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "input_digest": { "type": "string", "minLength": 1 },
    "output_digest": { "type": ["string", "null"] },
    "reason": { "type": "string" }
  }
}
